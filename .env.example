# Copy to .env and change these before running on a public server.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
# Base64-encoded 256-bit key, e.g. `openssl rand -base64 32`. Must stay the same across restarts.
SECURITY_JWT_SECRET_KEY=
# Websites allowed to call the API (comma-separated).
ALLOWED_ORIGINS=https://rockjames007.github.io
# Create the README demo accounts (test@gmail.com / org@gmail.com).
DEMO_USERS_ENABLED=true
# Fill an empty database with sample events (fictional organizations and volunteers).
DEMO_EVENTS_ENABLED=true
# Time zone for event times and check-in windows.
TZ=Asia/Singapore
